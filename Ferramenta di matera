    <div class="ph"><img src="${W + img}" alt="${n}" loading="lazy" width="150" height="150" data-i="${BEST.findIndex(b => b[0] === n)}" onerror="this.dataset.failed=1; window.feFallback && feFallback(this)"><span class="tag num">${eur(p)}</span></div>
