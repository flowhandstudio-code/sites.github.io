  </article>`).join('');
</script>

<script type="module">
/* =========================================================================
   La vite che si avvita: Three.js guidato dallo scroll.
   - geometria: testa e dado esagonali estrusi (Shape con foro), filetto come
     TubeGeometry lungo un'elica, rondella ad anello, minuteria di sfondo istanziata
   - materiali: acciaio zincato con mappa di rugosità spazzolata, dado con
     zincatura gialla (iridescence), pavimento con carta millimetrata in shader
   - luci: ambiente RoomEnvironment per i riflessi del metallo, luce chiave calda
     e controluce blu del marchio
   - animazione: il dado sale e ruota secondo il passo reale del filetto
   - post: profondità di campo (Bokeh), bloom leggero, grading, OutputPass
   - prestazioni: InstancedMesh, MSAA nel composer, niente lavoro fuori schermo,
     profondità di campo spenta sui telefoni, shader compilati prima del primo frame
   ========================================================================= */
import * as THREE from 'three';
import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { BokehPass } from 'three/addons/postprocessing/BokehPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';
import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';

const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const mobile = innerWidth < 1000;
const canvas = document.getElementById('bolt3d');
let renderer;
try { renderer = new THREE.WebGLRenderer({canvas, antialias: false, powerPreference: 'high-performance'}); }
catch (e){ canvas.insertAdjacentHTML('afterend', '<p class="no3d">La vista 3D non è disponibile su questo dispositivo.</p>'); throw e; }
renderer.setPixelRatio(Math.min(devicePixelRatio, mobile ? 1.5 : 1.75));
renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1;

const BG = new THREE.Color('#e9e8e4');
const scene = new THREE.Scene();
scene.background = BG; scene.fog = new THREE.Fog(BG, 16, 34);
const pmrem = new THREE.PMREMGenerator(renderer); const room = new RoomEnvironment();
scene.environment = pmrem.fromScene(room, .03).texture; scene.environmentIntensity = 1; room.dispose(); pmrem.dispose();
const camera = new THREE.PerspectiveCamera(mobile ? 40 : 32, 1, .1, 80);
camera.position.set(0, 9, 26);   // all'apertura la camera arriva da lontano

/* ---------- texture: acciaio spazzolato (rugosità, dato scalare) ---------- */
function brushed(){
  const s = 512, c = document.createElement('canvas'); c.width = c.height = s; const g = c.getContext('2d');
  g.fillStyle = 'rgb(110,110,110)'; g.fillRect(0, 0, s, s);
  for (let i = 0; i < 1600; i++){ const v = 80 + Math.random() * 90; g.strokeStyle = `rgba(${v},${v},${v},.35)`; g.lineWidth = Math.random() * 1.5; const y = Math.random() * s; g.beginPath(); g.moveTo(0, y); g.lineTo(s, y + (Math.random() - .5) * 4); g.stroke(); }
  const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(1, 3); return t;
}
const rough = brushed();
const zinc = new THREE.MeshStandardMaterial({color: '#cfd5da', metalness: 1, roughness: .38, roughnessMap: rough});
// zincatura gialla: la passivazione dà quei riflessi arcobaleno, resi con l'iridescenza
const yellowZinc = new THREE.MeshPhysicalMaterial({color: '#d6bd73', metalness: 1, roughness: .3, iridescence: .45, iridescenceIOR: 1.4, iridescenceThicknessRange: [260, 420]});

/* ---------- geometria ---------- */
const hexShape = (r, hole) => {
  const s = new THREE.Shape();
  for (let i = 0; i < 6; i++){ const a = i / 6 * Math.PI * 2 + Math.PI / 6; i ? s.lineTo(Math.cos(a) * r, Math.sin(a) * r) : s.moveTo(Math.cos(a) * r, Math.sin(a) * r); }
  s.closePath();
  if (hole){ const h = new THREE.Path(); h.absarc(0, 0, hole, 0, Math.PI * 2, true); s.holes.push(h); }
  return s;
};
const extrudeY = (shape, depth, bevel) => {
  const g = new THREE.ExtrudeGeometry(shape, {depth, bevelEnabled: true, bevelThickness: bevel, bevelSize: bevel, bevelSegments: 3, curveSegments: 48});
  g.rotateX(-Math.PI / 2); g.translate(0, 0, 0); g.computeVertexNormals(); return g;   // spessore lungo +Y
};
const PITCH = .25, SHANK_R = .5, SHANK_L = 4.2;
const bolt = new THREE.Group();
const head = new THREE.Mesh(extrudeY(hexShape(1.05), .5, .07), zinc); head.position.y = SHANK_L;
const shank = new THREE.Mesh(new THREE.CylinderGeometry(SHANK_R - .05, SHANK_R - .05, SHANK_L, 48).translate(0, SHANK_L / 2, 0), zinc);
// filetto vero: un cilindro fitto deformato con il profilo triangolare che sale a elica (passo PITCH)
const THREAD_L = SHANK_L - .45;
const threadGeo = (() => {
  const g = new THREE.CylinderGeometry(1, 1, THREAD_L, 96, Math.round(THREAD_L / PITCH * 14), true), pos = g.attributes.position;
  const core = SHANK_R - .07, depth = .11;
  for (let i = 0; i < pos.count; i++){
    const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i), th = Math.atan2(z, x);
    const phase = ((y + th / (Math.PI * 2) * PITCH) / PITCH % 1 + 1) % 1;
    const r = core + depth * (1 - Math.abs(phase * 2 - 1));   // profilo a V
    pos.setXYZ(i, Math.cos(th) * r, y, Math.sin(th) * r);
  }
  g.computeVertexNormals(); return g.translate(0, THREAD_L / 2 + .02, 0);
})();
const thread = new THREE.Mesh(threadGeo, zinc);
const tip = new THREE.Mesh(new THREE.ConeGeometry(SHANK_R - .05, .18, 48).rotateX(Math.PI).translate(0, -.08, 0), zinc);
bolt.add(head, shank, thread, tip);
// marcatura sulla testa: "8.8", come sulle viti vere, incisa su una texture
{
  const c = document.createElement('canvas'); c.width = c.height = 256; const g = c.getContext('2d');
  g.fillStyle = '#000'; g.fillRect(0, 0, 256, 256); g.fillStyle = '#fff'; g.font = '700 64px "IBM Plex Sans Condensed", sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
  g.fillText('8.8', 128, 92); g.font = '600 34px "IBM Plex Sans Condensed", sans-serif'; g.fillText('FE', 128, 160);
  const t = new THREE.CanvasTexture(c);
  const mark = new THREE.Mesh(new THREE.CircleGeometry(.7, 48), new THREE.MeshStandardMaterial({color: '#9aa2aa', metalness: 1, roughness: .55, alphaMap: t, transparent: true, depthWrite: false}));
  mark.rotation.x = -Math.PI / 2; mark.position.y = SHANK_L + .575; bolt.add(mark);
}
const nut = new THREE.Mesh(extrudeY(hexShape(.98, SHANK_R + .06), .55, .06), yellowZinc);
const washer = new THREE.Mesh(extrudeY((() => { const s = new THREE.Shape(); s.absarc(0, 0, 1.25, 0, Math.PI * 2, false); const h = new THREE.Path(); h.absarc(0, 0, SHANK_R + .08, 0, Math.PI * 2, true); s.holes.push(h); return s; })(), .1, .015), zinc);
const rig = new THREE.Group(); rig.add(bolt, nut, washer);
rig.rotation.z = -.12; rig.position.set(0, -.6, 0);
scene.add(rig);

/* ---------- minuteria di sfondo, istanziata ---------- */
const N = mobile ? 50 : 130;
const smallGeos = [
  extrudeY(hexShape(.34, .18), .2, .02),
  extrudeY((() => { const s = new THREE.Shape(); s.absarc(0, 0, .42, 0, Math.PI * 2, false); const h = new THREE.Path(); h.absarc(0, 0, .19, 0, Math.PI * 2, true); s.holes.push(h); return s; })(), .05, .008),
  (() => { const g = new THREE.CylinderGeometry(.1, .1, 1.1, 16).translate(0, -.55, 0); const h = new THREE.CylinderGeometry(.24, .24, .12, 24).translate(0, .06, 0); const tp = new THREE.ConeGeometry(.1, .2, 16).rotateX(Math.PI).translate(0, -1.2, 0);
     const merged = new THREE.BufferGeometry(); const parts = [g, h, tp].map(x => x.toNonIndexed());
     const pos = []; const nor = []; parts.forEach(p => { pos.push(...p.attributes.position.array); nor.push(...p.attributes.normal.array); });
     merged.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3)); merged.setAttribute('normal', new THREE.Float32BufferAttribute(nor, 3)); return merged; })(),
];
const smallMats = [zinc, zinc, new THREE.MeshStandardMaterial({color: '#b88a4a', metalness: 1, roughness: .35})]; // dadi, rondelle, viti in ottone
const bits = smallGeos.map((g, k) => {
  const n = Math.round(N / 3), m = new THREE.InstancedMesh(g, smallMats[k], n);
  m.userData.items = Array.from({length: n}, () => ({
    p: new THREE.Vector3((Math.random() - .5) * 30, Math.random() * 14 - 3, -4 - Math.random() * 14),
    r: new THREE.Euler(Math.random() * 6, Math.random() * 6, Math.random() * 6),
    w: new THREE.Vector3((Math.random() - .5) * .4, (Math.random() - .5) * .4, (Math.random() - .5) * .4),
    s: .7 + Math.random() * .8,
  }));
  m.frustumCulled = false; scene.add(m); return m;
});
const dummy = new THREE.Object3D();
function updateBits(t, lift){
  for (const m of bits){
    m.userData.items.forEach((it, i) => {
      dummy.position.set(it.p.x, it.p.y + Math.sin(t * .4 + i) * .15 + lift * (1 + it.p.z * -.05), it.p.z);
      dummy.rotation.set(it.r.x + t * it.w.x, it.r.y + t * it.w.y, it.r.z + t * it.w.z);
      dummy.scale.setScalar(it.s); dummy.updateMatrix(); m.setMatrixAt(i, dummy.matrix);
    });
    m.instanceMatrix.needsUpdate = true;
  }
}

/* ---------- pavimento: carta millimetrata disegnata nello shader ---------- */
const grid = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), new THREE.ShaderMaterial({
  transparent: true, depthWrite: false,
  uniforms: {uInk: {value: new THREE.Color('#15181c')}, uBlue: {value: new THREE.Color('#1f4e9c')}, uCenter: {value: new THREE.Vector2(rig.position.x, 0)}},
  vertexShader: /* glsl */`varying vec2 vP; void main(){ vec4 w = modelMatrix * vec4(position, 1.0); vP = w.xz; gl_Position = projectionMatrix * viewMatrix * w; }`,
  fragmentShader: /* glsl */`
    uniform vec3 uInk; uniform vec3 uBlue; uniform vec2 uCenter; varying vec2 vP;
    float line(float v, float w){ float d = abs(fract(v - 0.5) - 0.5) / fwidth(v); return 1.0 - min(d / w, 1.0); }
    void main(){
      float mm = max(line(vP.x * 10.0, 1.0), line(vP.y * 10.0, 1.0)) * 0.10;   // millimetri
      float cm = max(line(vP.x, 1.2), line(vP.y, 1.2)) * 0.35;                    // centimetri
      float fade = 1.0 - smoothstep(3.0, 16.0, distance(vP, uCenter));
      float a = max(mm, cm) * fade;
      vec3 col = mix(uInk, uBlue, cm > mm ? 0.6 : 0.0);
      gl_FragColor = vec4(col, a * 0.55);
      #include <tonemapping_fragment>
      #include <colorspace_fragment>
    }`,
}));
grid.rotation.x = -Math.PI / 2; grid.position.y = -1.6; scene.add(grid);
// ombra di contatto sotto la vite
{
  const c = document.createElement('canvas'); c.width = c.height = 128; const g = c.getContext('2d');
  const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64); gr.addColorStop(0, 'rgba(21,24,28,.35)'); gr.addColorStop(1, 'rgba(21,24,28,0)'); g.fillStyle = gr; g.fillRect(0, 0, 128, 128);
  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace;
  const blob = new THREE.Mesh(new THREE.PlaneGeometry(4.2, 4.2), new THREE.MeshBasicMaterial({map: t, transparent: true, depthWrite: false, toneMapped: false}));
  blob.rotation.x = -Math.PI / 2; blob.position.set(rig.position.x, -1.59, 0); scene.add(blob);
}

/* ---------- luci ---------- */
const key = new THREE.DirectionalLight('#fff1dc', 2.4); key.position.set(-4, 7, 6);
const rim = new THREE.DirectionalLight('#5b8fe6', 3); rim.position.set(6, 3, -6);   // controluce nel blu del marchio
const click = new THREE.PointLight('#ffe7a3', 0, 6, 2); click.position.set(rig.position.x, 3.2, 1.6);
scene.add(key, rim, click, new THREE.HemisphereLight('#ffffff', '#b9b4aa', .4));

/* ---------- post-processing ---------- */
const rt = new THREE.WebGLRenderTarget(1, 1, {type: THREE.HalfFloatType, samples: 4});
const composer = new EffectComposer(renderer, rt);
composer.addPass(new RenderPass(scene, camera));
const bokeh = new BokehPass(scene, camera, {focus: 9, aperture: .0016, maxblur: .007});
bokeh.enabled = !mobile;   // sui telefoni la profondità di campo costa troppo
composer.addPass(bokeh);
composer.addPass(new UnrealBloomPass(new THREE.Vector2(512, 512), .18, .5, .92));
const uTime = {value: 0};
composer.addPass(new ShaderPass({
  uniforms: {tDiffuse: {value: null}, uTime},
  vertexShader: /* glsl */`varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
  fragmentShader: /* glsl */`
    uniform sampler2D tDiffuse; uniform float uTime; varying vec2 vUv;
    float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
    void main(){
      vec4 c = texture2D(tDiffuse, vUv);
      float v = smoothstep(1.05, .35, length(vUv - .5));
      c.rgb *= mix(.82, 1.0, v);
      c.rgb += (hash(vUv * 900.0 + fract(uTime)) - .5) * .018;
      gl_FragColor = c;
    }`,
}));
composer.addPass(new OutputPass());

/* ---------- dimensioni e visibilità ---------- */
const pin = document.querySelector('.run-pin'), run = document.getElementById('vite');
function resize(){
  const w = pin.clientWidth, h = pin.clientHeight;
  renderer.setSize(w, h, false); composer.setSize(w, h);
  camera.aspect = w / h;
  // su schermi larghi sposto l'inquadratura: la vite finisce a destra, il testo resta libero a sinistra
  if (w > 1000) camera.setViewOffset(w, h, -w * .2, 0, w, h); else camera.clearViewOffset();
  camera.updateProjectionMatrix();
}
addEventListener('resize', resize); resize();
let visible = true;
new IntersectionObserver(([e]) => visible = e.isIntersecting).observe(run);

/* ---------- scroll e puntatore ---------- */
let target = 0, cur = 0;
const readScroll = () => { const span = run.offsetHeight - innerHeight; target = THREE.MathUtils.clamp(-run.getBoundingClientRect().top / span, 0, 1); };
addEventListener('scroll', readScroll, {passive: true}); readScroll();
const mouse = new THREE.Vector2(), look = new THREE.Vector2();
addEventListener('pointermove', e => mouse.set(e.clientX / innerWidth - .5, e.clientY / innerHeight - .5), {passive: true});

const steps = [...document.querySelectorAll('.step')], mmEl = document.getElementById('mm'), ruler = document.querySelector('.ruler');
const smooth = x => x * x * (3 - 2 * x);
const seg = (p, a, b) => smooth(THREE.MathUtils.clamp((p - a) / (b - a), 0, 1));
const NUT_TOP = SHANK_L - .12 - .55, NUT_START = -2.4;   // finisce sotto la rondella
const WASHER_TOP = SHANK_L - .12, WASHER_START = -1.4;
const center = new THREE.Vector3(), camGoal = new THREE.Vector3();
let lastStep = 0, last = performance.now(), t = 0, clicked = false;

/* ---------- ripiego per le foto che non arrivano: illustrazione 3D del prodotto ---------- */
// un secondo renderer piccolo, usato solo se una foto del sito non si carica
let shot = null;
function packshot(name){
  if (!shot){
    const c = document.createElement('canvas'); c.width = c.height = 400;
    const r = new THREE.WebGLRenderer({canvas: c, antialias: true, preserveDrawingBuffer: true});
    r.setSize(400, 400, false); r.toneMapping = THREE.ACESFilmicToneMapping;
    const s = new THREE.Scene(); s.background = new THREE.Color('#ffffff');
    const pm = new THREE.PMREMGenerator(r); const rm = new RoomEnvironment(); s.environment = pm.fromScene(rm, .04).texture; rm.dispose(); pm.dispose();
    const k = new THREE.DirectionalLight('#fff', 2); k.position.set(-3, 5, 4); s.add(k);
    shot = {r, s, c, cam: new THREE.PerspectiveCamera(26, 1, .1, 50)};
  }
  const n = name.toLowerCase(), grp = new THREE.Group(), disposables = [];
  const keep = x => (disposables.push(x), x);
  // etichetta: fascia blu del marchio e nome del prodotto
  const label = (w, h) => {
    const cv = document.createElement('canvas'); cv.width = w; cv.height = h; const g = cv.getContext('2d');
    g.fillStyle = '#fffdf4'; g.fillRect(0, 0, w, h); g.fillStyle = '#1f4e9c'; g.fillRect(0, 0, w, h * .2);
    g.fillStyle = '#fff'; g.font = `700 ${h * .12}px "IBM Plex Sans Condensed", sans-serif`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText('FERROELETTRA', w / 2, h * .1);
    g.fillStyle = '#15181c'; let fs = h * .13; const words = name.split(' '); let lines;
    do { g.font = `600 ${fs}px "IBM Plex Sans Condensed", sans-serif`; lines = []; let l = '';
      for (const wd of words){ const t2 = l ? l + ' ' + wd : wd; if (g.measureText(t2).width > w * .82 && l){ lines.push(l); l = wd; } else l = t2; } lines.push(l); fs *= .9;
    } while (lines.length * fs * 1.25 > h * .7 && fs > 8);
    lines.forEach((l, i) => g.fillText(l, w / 2, h * .25 + (h * .75) / 2 + (i - (lines.length - 1) / 2) * fs * 1.2));
    const t = keep(new THREE.CanvasTexture(cv)); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 8; return keep(new THREE.MeshStandardMaterial({map: t, roughness: .8}));
  };
  const add = (geo, mat) => { const m = new THREE.Mesh(keep(geo), mat); grp.add(m); return m; };
  const steel = keep(new THREE.MeshStandardMaterial({color: '#d4d9de', metalness: 1, roughness: .25}));
  if (/vetro sintetico|telo|feltro/.test(n)){
    const roll = keep(new THREE.MeshPhysicalMaterial({color: /feltro/.test(n) ? '#e8e2d4' : '#dfe9ee', roughness: /feltro/.test(n) ? .95 : .1, transparent: !/feltro/.test(n), opacity: .85, clearcoat: /feltro/.test(n) ? 0 : 1}));
    add(new THREE.CylinderGeometry(.55, .55, 2, 48).rotateZ(Math.PI / 2), roll);
    add(new THREE.CylinderGeometry(.16, .16, 2.04, 24).rotateZ(Math.PI / 2), keep(new THREE.MeshStandardMaterial({color: '#b08a5c', roughness: .9})));
    const tag = add(new THREE.PlaneGeometry(1.1, .62), label(560, 320)); tag.position.set(0, 0, .56);
  } else if (/zigzag|bostik|adesivo/.test(n)){
    add(new THREE.CylinderGeometry(.42, .42, 1.5, 48), label(820, 760));
    add(new THREE.CylinderGeometry(.2, .3, .3, 32).translate(0, .9, 0), keep(new THREE.MeshStandardMaterial({color: '#f2c230', roughness: .4})));
  } else if (/damigiana/.test(n)){
    add(new THREE.LatheGeometry([[0,0],[.75,0],[.85,.4],[.85,1.1],[.5,1.5],[.2,1.65],[.2,1.9],[0,1.9]].map(([x, y]) => new THREE.Vector2(x, y)), 48).translate(0, -.95, 0),
      keep(new THREE.MeshPhysicalMaterial({color: '#e6f2ea', roughness: .05, transparent: true, opacity: .45, clearcoat: 1})));
    add(new THREE.CylinderGeometry(.9, .8, .8, 24, 1, true).translate(0, -.55, 0), keep(new THREE.MeshStandardMaterial({color: '#f2c230', roughness: .6, side: THREE.DoubleSide, wireframe: true})));
    add(new THREE.CylinderGeometry(.23, .23, .2, 24).translate(0, 1.0, 0), keep(new THREE.MeshStandardMaterial({color: '#f2c230', roughness: .5})));
  } else if (/asta/.test(n)){
    add(new THREE.CylinderGeometry(.09, .09, 2.6, 24).rotateZ(Math.PI / 2).rotateY(.5), steel);
    add(new THREE.CylinderGeometry(.11, .11, 1.1, 24).rotateZ(Math.PI / 2).rotateY(.5).translate(.55, 0, -.28), steel);
    const tag = add(new THREE.PlaneGeometry(1.2, .7), label(560, 330)); tag.position.set(-.2, -.55, .3);
  } else if (/cerniera/.test(n)){
    add(new THREE.CylinderGeometry(.45, .45, .25, 40).translate(-.6, 0, 0), steel);
    add(new THREE.BoxGeometry(1.6, .12, .45).translate(.4, .13, 0), steel);
    add(new THREE.BoxGeometry(.9, .1, .7).translate(1.1, -.1, 0), steel);
    grp.rotation.set(.9, -.3, 0);
  } else if (/zanzariera|pannello|maniglie|fornellone|alza|ferma|prefiltro/.test(n)){
    add(new THREE.BoxGeometry(1.3, 1.7, .12), [steel, steel, steel, steel, label(600, 780), steel]);
  } else {
    const card = keep(new THREE.MeshStandardMaterial({color: '#c8a77a', roughness: .9}));
    add(new THREE.BoxGeometry(1.3, 1.3, .9), [card, card, card, card, label(600, 600), card]);
  }
  grp.rotation.y += -.35;
  shot.s.add(grp);
  const box = new THREE.Box3().setFromObject(grp), size = box.getSize(new THREE.Vector3()), ctr = box.getCenter(new THREE.Vector3());
  const d = Math.max(size.x, size.y) / (2 * Math.tan(THREE.MathUtils.degToRad(13))) * 1.25 + size.z;
  shot.cam.position.set(ctr.x + d * .15, ctr.y + d * .2, ctr.z + d); shot.cam.lookAt(ctr);
  shot.r.render(shot.s, shot.cam);
  const url = shot.c.toDataURL('image/jpeg', .9);
  shot.s.remove(grp); disposables.forEach(x => x.dispose && x.dispose());
  return url;
}
window.feFallback = img => { const i = +img.dataset.i; if (i < 0) return; img.dataset.shot = 1; img.src = packshot(BEST[i][0]); };
// foto già fallite prima che il modulo fosse pronto
document.querySelectorAll('img[data-failed]').forEach(feFallback);
window.fe3d = {packshot};

// shader compilati in anticipo: niente scatti al primo fotogramma
await renderer.compileAsync(scene, camera);

renderer.setAnimationLoop(now => {
  const dt = Math.min(.05, (now - last) / 1000); last = now;
  if (!visible || document.hidden) return;
  if (!reduce) t += dt; uTime.value = t;
  cur = reduce ? target : THREE.MathUtils.damp(cur, target, 5, dt);

  // rondella: sale per prima; dado: sale ruotando secondo il passo del filetto
  const pw = seg(cur, .12, .3), pn = seg(cur, .26, .86);
  washer.position.y = THREE.MathUtils.lerp(WASHER_START, WASHER_TOP, pw);
  washer.rotation.y = Math.sin(t * .8) * .05 * (1 - pw);
  nut.position.y = THREE.MathUtils.lerp(NUT_START, NUT_TOP, pn);
  nut.rotation.y = -(nut.position.y - NUT_START) / PITCH * Math.PI * 2;
  // a fine corsa: un lampo di luce, come lo scatto della chiave dinamometrica
  if (pn >= .999 && !clicked){ clicked = true; click.intensity = 40; }
  if (pn < .98) clicked = false;
  click.intensity = THREE.MathUtils.damp(click.intensity, 0, 4, dt);

  // tutta la vite gira piano finché il dado non è stretto
  rig.rotation.y = (1 - pn) * t * .25 + pn * .4;

  // telecamera in orbita attorno al pezzo
  look.x = THREE.MathUtils.damp(look.x, mouse.x, 3, dt); look.y = THREE.MathUtils.damp(look.y, mouse.y, 3, dt);
  center.set(rig.position.x, 1.6 + cur * .6 + (mobile ? 1.6 : 0), 0);
  const az = .55 - cur * .9 + look.x * .25, el = .18 + cur * .1 - look.y * .1, rad = (mobile ? 15 : 13) - cur * 2;
  camGoal.set(center.x + Math.sin(az) * rad * Math.cos(el), center.y + Math.sin(el) * rad, Math.cos(az) * rad * Math.cos(el));
  camera.position.lerp(camGoal, reduce ? 1 : 1 - Math.exp(-4 * dt)); camera.lookAt(center);
  bokeh.uniforms.focus.value = camera.position.distanceTo(rig.position) + .5;   // a fuoco sulla vite, non sul centro dell'inquadratura

  updateBits(t, cur * 3);

  // testi, righello
  const st = Math.min(steps.length - 1, Math.floor(cur * steps.length * .999));
  if (st !== lastStep){ steps[lastStep].classList.remove('on'); steps[st].classList.add('on'); lastStep = st; }
  const travel = (nut.position.y - NUT_START) * 10;   // 1 unità = 10 mm
  mmEl.textContent = `${Math.round(travel)} mm`;
  mmEl.style.top = `${(1 - pn) * 100}%`;
  ruler.style.opacity = cur > .05 ? .75 : 0;

  composer.render(dt);
});
</script>
