<style>
/* Palette da banco di ferramenta: cemento, acciaio zincato, il blu del marchio, il giallo dei cartellini prezzo */
:root{
  --cemento:#e9e8e4;
  --bianco:#ffffff;
  --inchiostro:#15181c;
  --acciaio:#8d97a1;
  --blu:#1f4e9c;
  --blu-d:#173b77;
  --giallo:#f2c230;
  --soft:#5a6169;
  --rule:rgba(21,24,28,.14);
  --cond:"IBM Plex Sans Condensed",system-ui,sans-serif;
  --sans:"IBM Plex Sans",system-ui,sans-serif;
  --ease:cubic-bezier(.2,.8,.2,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:var(--sans);font-size:16px;line-height:1.55;color:var(--inchiostro);background:var(--cemento)}
img{display:block;max-width:100%}
a{color:inherit}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:3px solid var(--blu);outline-offset:2px}
.wrap{width:min(1240px,100% - 32px);margin-inline:auto}
.num{font-variant-numeric:tabular-nums}
h1,h2,h3{font-family:var(--cond);font-weight:700;line-height:1;letter-spacing:-.01em}

/* ---------- barra e testata ---------- */
.service{background:var(--inchiostro);color:#fff;font-size:14px;padding:8px 16px;text-align:center}
.service a{color:var(--giallo);font-weight:600;text-decoration:none}
.head{position:sticky;top:0;z-index:40;background:rgba(233,232,228,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--rule)}
.head .wrap{display:flex;align-items:center;gap:22px;height:68px}
.logo img{height:40px;width:auto}
.nav{display:flex;gap:22px;list-style:none;margin-left:auto;font-size:15px;font-weight:500}
.nav a{text-decoration:none;padding:6px 0;border-bottom:2px solid transparent}
.nav a:hover{border-color:var(--blu)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 20px;font-weight:600;text-decoration:none;border-radius:6px;border:1.5px solid transparent;transition:background .2s,color .2s}
.btn-blu{background:var(--blu);color:#fff}
.btn-blu:hover{background:var(--blu-d)}
.btn-line{border-color:var(--inchiostro)}
.btn-line:hover{background:var(--inchiostro);color:#fff}
.head .btn{padding:10px 14px;font-size:15px}

/* ---------- la vite: sezione bloccata guidata dallo scroll ---------- */
.run{position:relative;height:420vh}
.run-pin{position:sticky;top:0;height:100svh;overflow:hidden}
#bolt3d{position:absolute;inset:0;width:100%;height:100%;display:block}
.steps{position:absolute;left:max(16px,(100vw - 1240px)/2);top:50%;transform:translateY(-42%);width:min(520px,calc(100% - 32px));z-index:2}
.step{position:absolute;left:0;top:0;width:100%;opacity:0;transform:translateY(18px);transition:opacity .55s var(--ease),transform .55s var(--ease);pointer-events:none}
.step.on{opacity:1;transform:none;pointer-events:auto}
.step h1{font-size:clamp(44px,6vw,86px);margin-bottom:18px}
.step h2{font-size:clamp(34px,4.4vw,62px);margin-bottom:14px}
.step p{font-size:18px;max-width:42ch;color:var(--soft)}
.step .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.kpi{display:block;font-family:var(--cond);font-weight:700;font-size:clamp(64px,8vw,120px);line-height:.9;color:var(--blu)}
/* righello a destra: la corsa del dado, in millimetri */
.ruler{position:absolute;right:max(16px,(100vw - 1240px)/2);top:16%;bottom:16%;width:56px;z-index:2;
  background:repeating-linear-gradient(to bottom,var(--inchiostro) 0 1px,transparent 1px 10px) right/12px 100% no-repeat,
             repeating-linear-gradient(to bottom,var(--inchiostro) 0 1.5px,transparent 1.5px 50px) right/24px 100% no-repeat;opacity:.75}
.ruler i{position:absolute;right:28px;top:0;transform:translateY(-50%);font-style:normal;font-family:var(--cond);font-weight:700;font-size:15px;background:var(--giallo);padding:2px 6px;border-radius:3px;white-space:nowrap}
.ruler i::after{content:"";position:absolute;right:-6px;top:50%;transform:translateY(-50%);border:6px solid transparent;border-left-color:var(--giallo);border-right:0}
.no3d{position:absolute;inset:0;display:grid;place-items:center;color:var(--soft)}

/* ---------- reparti: la cassettiera ---------- */
section{position:relative}
.depts{padding:110px 0 90px;background:var(--bianco)}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:36px}
.sec-head h2{font-size:clamp(36px,4.6vw,64px);max-width:16ch}
.sec-head p{color:var(--soft);max-width:44ch}
.cabinet{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;padding:14px;background:#2f3a46;border-radius:10px;perspective:900px;
  box-shadow:inset 0 2px 0 rgba(255,255,255,.08),0 30px 60px -30px rgba(21,24,28,.6)}
.drawer{position:relative;display:flex;flex-direction:column;justify-content:space-between;min-height:116px;padding:12px 12px 10px;border-radius:5px;text-decoration:none;
  background:linear-gradient(180deg,#d8dde2,#c3cad1);box-shadow:inset 0 -3px 0 rgba(0,0,0,.12),0 2px 0 rgba(0,0,0,.25);
  transform-style:preserve-3d;transition:transform .45s var(--ease),box-shadow .45s var(--ease)}
.drawer:hover,.drawer:focus-visible{transform:translateZ(46px) translateY(-4px);box-shadow:inset 0 -3px 0 rgba(0,0,0,.12),0 22px 30px -12px rgba(0,0,0,.55)}
.drawer .card{background:#fffdf4;border:1px solid rgba(0,0,0,.18);padding:6px 8px;font-family:var(--cond);font-weight:600;font-size:15px;line-height:1.15;min-height:52px}
.drawer .card span{display:block;font-family:var(--sans);font-weight:500;font-size:12px;color:var(--soft);margin-top:4px}
.drawer .pull{align-self:center;width:44%;height:10px;border-radius:6px;background:linear-gradient(180deg,#f4f6f8,#8d97a1);box-shadow:0 2px 2px rgba(0,0,0,.3);margin-top:10px}
.drawer.big{grid-column:span 2}
.drawer.big .card{font-size:19px}

/* ---------- bestseller con cartellino ---------- */
.best{padding:100px 0}
.shelf{display:grid;grid-template-columns:repeat(5,1fr);gap:28px 18px}
.item{display:flex;flex-direction:column}
.item .ph{position:relative;aspect-ratio:1;background:#fff;border-radius:8px;display:grid;place-items:center;overflow:hidden;border:1px solid var(--rule)}
.item .ph img{width:150px;height:150px;object-fit:contain;transition:transform .5s var(--ease)}
.item:hover .ph img{transform:scale(1.06)}
.item .ph img[data-failed]:not([data-shot]){visibility:hidden}
.item .ph img[data-shot]{width:100%;height:100%;object-fit:cover}
.tag{position:absolute;right:-6px;top:14px;background:var(--giallo);font-family:var(--cond);font-weight:700;font-size:22px;padding:4px 12px 4px 20px;
  clip-path:polygon(12px 0,100% 0,100% 100%,12px 100%,0 50%);transform:rotate(4deg);transform-origin:right center;transition:transform .4s var(--ease)}
.tag::before{content:"";position:absolute;left:8px;top:50%;width:6px;height:6px;border-radius:50%;background:#fff;transform:translateY(-50%)}
.item:hover .tag{transform:rotate(-3deg)}
.item h3{font-family:var(--sans);font-weight:500;font-size:15px;line-height:1.35;margin:12px 0 4px;flex:1}
.item .vat{font-size:12px;color:var(--soft)}
.item a.go{margin-top:8px;font-weight:600;font-size:14px;color:var(--blu)}

/* ---------- marchi e servizio ---------- */
.brands{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:56px}
.brands img{width:100%;border-radius:8px;border:1px solid var(--rule)}
.help{background:var(--inchiostro);color:#fff;padding:100px 0}
.help-grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(32px,6vw,96px);align-items:center}
.help h2{font-size:clamp(38px,5vw,72px);margin-bottom:16px}
.help p{color:rgba(255,255,255,.75);max-width:46ch}
.phone{display:block;font-family:var(--cond);font-weight:700;font-size:clamp(48px,7vw,96px);line-height:1;text-decoration:none;margin:22px 0 10px;color:var(--giallo)}
.facts{list-style:none;border-top:1px solid rgba(255,255,255,.2)}
.facts li{padding:16px 0;border-bottom:1px solid rgba(255,255,255,.2);display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start}
.facts svg{color:var(--giallo)}
.facts b{display:block;font-family:var(--cond);font-size:22px}
.facts span{color:rgba(255,255,255,.7);font-size:15px}
footer{background:#0d0f12;color:rgba(255,255,255,.65);padding:40px 0;font-size:14px}
footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
footer a{color:#fff}

@media (max-width:1000px){
  .nav{display:none}
  .head .btn{margin-left:auto}
  .cabinet{grid-template-columns:repeat(3,1fr)}
  .shelf{grid-template-columns:repeat(2,1fr)}
  .brands{grid-template-columns:1fr}
  .help-grid{grid-template-columns:1fr}
  .steps{top:auto;bottom:6vh;transform:none}
  .step{top:auto;bottom:0}
  .step p{font-size:16px;background:rgba(233,232,228,.85);padding:2px 0}
  .ruler{display:none}
}
@media (max-width:520px){ .cabinet{grid-template-columns:repeat(2,1fr)} .drawer.big{grid-column:span 2} .head .long{display:none} }
@media (prefers-reduced-motion:reduce){ *,*::before,*::after{transition-duration:.01ms!important} }
</style>
</head>
